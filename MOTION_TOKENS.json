  },
  "layers": {"L0": "static", "L1": "micro-interaction", "L2": "state-transition", "L3": "gameplay-emphasis", "L4": "ambient"},
  "budgets": {"lobbyActiveAmbientMax": 2, "profileActiveAmbientMax": 3, "gameShellAmbientMax": 0, "minimumTouchTargetPx": 44},
